# Copy this file to .env and fill in real values. .env is not committed.

# Database (ask the team lead for the values)
DB_URL=jdbc:mysql://<host>:4000/moh_db?useSSL=true&sslMode=VERIFY_IDENTITY&serverTimezone=UTC
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password

# Base64 key that signs login tokens (JWT); at least 32 bytes. Must be the same on every backend instance.
JWT_SECRET_BASE64=your-base64-secret

# Gmail account that sends credential and password-reset emails
MAIL_USERNAME=your-email@gmail.com
# 16-character Gmail App Password, no spaces (https://myaccount.google.com/apppasswords)
MAIL_PASSWORD=your-app-password
